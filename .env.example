SMS_GATEWAY_URL=
# ... or the phone IP for Local mode (http://<ip>:8080 is used)
SMS_GATEWAY_IP=192.168.1.63
SMS_GATEWAY_LOGIN=
SMS_GATEWAY_PASSWORD=

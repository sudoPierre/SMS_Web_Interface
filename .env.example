# Database
POSTGRES_PASSWORD=changeme

# Authentication (checked by the backend login endpoint)
ADMIN_IDENTIFIER=admin
ADMIN_PASSWORD=changeme
SECRET_KEY=change_this_to_a_long_random_string

# Android SMS Gateway
# Either the full API URL (Cloud mode: https://api.sms-gate.app/3rdparty/v1) ...
SMS_GATEWAY_URL=
# ... or the phone IP for Local mode (http://<ip>:8080 is used)
SMS_GATEWAY_IP=192.168.1.63
SMS_GATEWAY_LOGIN=
SMS_GATEWAY_PASSWORD=

# SMS commands
# Comma-separated E.164 numbers allowed to run /commands (also see the authorized_numbers table)
AUTHORIZED_NUMBERS=+33600000000
# Home Assistant (/ha command) — long-lived access token from your HA profile
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

# AI agent (natural-language SMS). Leave empty to disable.
# Only numbers in the authorized_numbers table (web UI whitelist) can talk to it.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=low
# Home Assistant domains the agent may act on
AGENT_HA_DOMAINS=light,switch,fan,scene,script,input_boolean
